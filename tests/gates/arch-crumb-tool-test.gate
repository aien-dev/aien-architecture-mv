# tests/gates/arch-crumb-tool-test.gate
# The crumb tool's own unit tests (make -C tools/crumb test). Crumbs themselves are advisory (RFC-0003 Am2).
gate: ARCH-CRUMB-TOOL-TEST
manifest_version: 2
owner: aien-architecture
requires:
  - host
inputs:
  - tools/crumb/
  - tests/gates/
run:
  exec: tests/gates/run.sh
  args: ["crumb-tool-test"]
expects:
  exit: 0
  verdict: PASS
timeout: 5m
exactness: EXACT
cache_scope: machine
