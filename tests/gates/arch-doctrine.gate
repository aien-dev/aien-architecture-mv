# tests/gates/arch-doctrine.gate
# Mirrors hosted: none (doctrine consistency, always-run). Since #316 the checker is tools/doctrine/doctrine.om
# (seeded .om, built by the pinned compiler in tools/zero-legacy/omega.pin); NOT_RUN without AIEN_OMC.
gate: ARCH-DOCTRINE
manifest_version: 2
owner: aien-architecture
requires:
  - host
inputs:
  - tools/doctrine/
  - tools/zero-legacy/sha256.om
  - tools/zero-legacy/omega.pin
  - doctrine/
  - docs/
  - CURRENT_EXECUTION_PLAN.md
  - PLAN_AUTHORITY.md
  - tests/gates/
run:
  exec: tests/gates/run.sh
  args: ["doctrine"]
expects:
  exit: 0
  observe: ["doctrine_exit == 0"]
  verdict: PASS
timeout: 5m
exactness: EXACT
cache_scope: machine
