note SPDX-License-Identifier: Apache-2.0
note sha256: FIPS 180-4 SHA-256 of one file (or stdin when no argument), hex + newline on stdout.
note Seeded native Omega. 32-bit words live in ulong cells and are masked after every add.
note Capacity: 16 MiB of input (error exit 66 beyond). Exit 65 when the file cannot be read.
note usage: sha256 [FILE]

text tbad "sha256: cannot read input\n"
text tbig "sha256: input over 16 MiB\n"
text tnl "\n"

global inp uchar 16777216
global n ulong 1
global h ulong 8
global w ulong 64
global k ulong 64
global st ulong 8
global name uchar 4096
global hex uchar 64
global m ulong 1

const mask ulong 4294967295

fn initk to void
put k 0 1116352408
put k 1 1899447441
put k 2 3049323471
put k 3 3921009573
put k 4 961987163
put k 5 1508970993
put k 6 2453635748
put k 7 2870763221
put k 8 3624381080
put k 9 310598401
put k 10 607225278
put k 11 1426881987
put k 12 1925078388
put k 13 2162078206
put k 14 2614888103
put k 15 3248222580
put k 16 3835390401
put k 17 4022224774
put k 18 264347078
put k 19 604807628
put k 20 770255983
put k 21 1249150122
put k 22 1555081692
put k 23 1996064986
put k 24 2554220882
put k 25 2821834349
put k 26 2952996808
put k 27 3210313671
put k 28 3336571891
put k 29 3584528711
put k 30 113926993
put k 31 338241895
put k 32 666307205
put k 33 773529912
put k 34 1294757372
put k 35 1396182291
put k 36 1695183700
put k 37 1986661051
put k 38 2177026350
put k 39 2456956037
put k 40 2730485921
put k 41 2820302411
put k 42 3259730800
put k 43 3345764771
put k 44 3516065817
put k 45 3600352804
put k 46 4094571909
put k 47 275423344
put k 48 430227734
put k 49 506948616
put k 50 659060556
put k 51 883997877
put k 52 958139571
put k 53 1322822218
put k 54 1537002063
put k 55 1747873779
put k 56 1955562222
put k 57 2024104815
put k 58 2227730452
put k 59 2361852424
put k 60 2428436474
put k 61 2756734187
put k 62 3204031479
put k 63 3329325298
end

fn inith to void
put h 0 1779033703
put h 1 3144134277
put h 2 1013904242
put h 3 2773480762
put h 4 1359893119
put h 5 2600822924
put h 6 528734635
put h 7 1541459225
end

fn rotr x ulong r ulong to ulong
ret and or shr x r shl x sub 32 r mask
end

fn bsig0 x ulong to ulong
ret xor rotr x 2 xor rotr x 13 rotr x 22
end

fn bsig1 x ulong to ulong
ret xor rotr x 6 xor rotr x 11 rotr x 25
end

fn ssig0 x ulong to ulong
ret xor rotr x 7 xor rotr x 18 shr x 3
end

fn ssig1 x ulong to ulong
ret xor rotr x 17 xor rotr x 19 shr x 10
end

fn ch x ulong y ulong z ulong to ulong
ret xor and x y and and not x mask z
end

fn maj x ulong y ulong z ulong to ulong
ret xor and x y xor and x z and y z
end

note load the 16 big-endian words of block b (byte offset) into w, then expand
fn sched b ulong to void
for i ulong 16
o = add b mul i 4
v = ulong get inp o
v = or shl v 8 ulong get inp add o 1
v = or shl v 8 ulong get inp add o 2
v = or shl v 8 ulong get inp add o 3
put w i v
end
for j ulong 48
i = add j 16
s = add ssig1 get w sub i 2 get w sub i 7
s = add s ssig0 get w sub i 15
s = add s get w sub i 16
put w i and s mask
end
end

fn round i ulong to void
a = get st 0
e = get st 4
t1 = add get st 7 bsig1 e
t1 = add t1 ch e get st 5 get st 6
t1 = add t1 get k i
t1 = and add t1 get w i mask
t2 = and add bsig0 a maj a get st 1 get st 2 mask
put st 7 get st 6
put st 6 get st 5
put st 5 e
put st 4 and add get st 3 t1 mask
put st 3 get st 2
put st 2 get st 1
put st 1 a
put st 0 and add t1 t2 mask
end

fn block b ulong to void
sched b
for i ulong 8
put st i get h i
end
for i ulong 64
round i
end
for i ulong 8
put h i and add get h i get st i mask
end
end

note pad in place: 0x80, zeros, 64-bit big-endian bit length; returns padded length
fn pad to ulong
sz = get n 0
put inp sz 128
p = add sz 1
while ne rem p 64 56 bound 64
put inp p 0
p = add p 1
end
bits = mul sz 8
for i ulong 8
put inp add p i uchar and shr bits mul sub 7 i 8 255
end
ret add p 8
end

fn hexd v ulong to uchar
if lt v 10
ret uchar add v 48
end
ret uchar add v 87
end

fn emit to void
for i ulong 8
v = get h i
for j ulong 8
d = and shr v mul sub 7 j 4 15
put hex add mul i 8 j hexd d
end
end
r = write 1 hex 0 64
r = write 1 tnl 0 1
end

note read the whole descriptor into inp; false on error or overflow
fn slurp fd int to bool
t = ulong 0
while true bound 999999
room = sub len inp t
if eq room 0
ret false
end
r = read fd inp t room
if lt r 0
ret false
end
if eq r 0
break
end
t = add t ulong r
end
put n 0 t
ret true
end

fn main to int
initk
inith
fd = int 0
if ge argcnt 2
l = argread 1 name 0 4095
if lt l 1
r = write 2 tbad 0 len tbad
ret 65
end
fd = int fopen name 0 ulong l 0 0
if lt fd 0
r = write 2 tbad 0 len tbad
ret 65
end
end
if not slurp fd
if eq get n 0 0
r = write 2 tbad 0 len tbad
ret 65
end
r = write 2 tbig 0 len tbig
ret 66
end
if gt get n 0 sub len inp 72
r = write 2 tbig 0 len tbig
ret 66
end
total = pad
b = ulong 0
while lt b total bound 262145
block b
b = add b 64
end
emit
ret 0
end
