#!/bin/sh
# spark-calibrate: the one calibration file of a measurement window.
#
# Run inside an open window (spark-window run spark-calibrate, or with
# SPARK_WINDOW set). It holds the GPU lock (default /tmp/aien-gb10.lock;
# SPARK_GB10_LOCK overrides it, same as the other scripts), waits for it, and
# prints the holders every 60 s. It measures:
#   1. CPU memory bandwidth with the omega#583 memcpy probe (pinned source
#      omega research/cost-sim-583@3bd56731 tools/dagsim/memcpy_probe.c), the
#      same call research/583 used: nice -n 10 memcpy_probe 1 K 10, K = 1 and 8.
#      Skipped (and said so) when MemAvailable is under 14.5 GiB (12 GiB
#      headroom rule plus the probe's 2 GB).
#   2. Idle power at the wall: 30 s of nothing, through spark-receipt.
# Writes ~/yardsticks/windows/<id>/calibration.json (raw CSVs and the idle
# receipt beside it). Every receipt taken later in the window links that file.
set -u
WR=${SPARK_WINDOWS_ROOT:-$HOME/yardsticks/windows}
id=${SPARK_WINDOW:-$(spark-window id)} || { echo "spark-calibrate: no open window; run spark-window open NAME first" >&2; exit 1; }
[ "$(cat "$WR/OPEN" 2>/dev/null)" = "$id" ] && [ -f "$WR/$id/held" ] || { echo "spark-calibrate: window $id is not the open, held window" >&2; exit 1; }
held() { [ "$(cat "$WR/OPEN" 2>/dev/null)" = "$id" ] && [ -f "$WR/$id/held" ] && [ ! -f "$WR/$id/expired" ] && kill -0 "$(cat "$WR/$id/holder.pid" 2>/dev/null)" 2>/dev/null; }
d=$WR/$id; mkdir -p "$d/calibration"
export SPARK_WINDOW=$id SPARK_WINDOW_DIR=$d
G=${SPARK_GB10_LOCK:-/tmp/aien-gb10.lock}

# the probe, built once per source blob + flags
REPO=${OMEGA_REPO:-$HOME/workspace/omega}; PIN=3bd56731c5517e2a9c8f195955c71e73dc6f9269; SRC=tools/dagsim/memcpy_probe.c
CFLAGS="-O2 -pthread"
blob=$(git -C "$REPO" rev-parse "$PIN:$SRC" 2>/dev/null) || { echo "spark-calibrate: cannot read $SRC at $PIN in $REPO (git fetch origin research/cost-sim-583)" >&2; exit 1; }
P=$HOME/.cache/spark-shared/memcpy_probe-$(echo "$blob $CFLAGS" | sha256sum | cut -c1-12)
if [ ! -x "$P" ]; then
  mkdir -p "${P%/*}"
  git -C "$REPO" cat-file -p "$blob" > "$P.c" && cc $CFLAGS -o "$P.tmp.$$" "$P.c" && mv -f "$P.tmp.$$" "$P" || { echo "spark-calibrate: probe build failed" >&2; exit 1; }
fi

t0=$(date +%s)
# A window opened with --gb10 exclusive|shared already holds the GPU lock for us (spark-window, L154);
# taking it again here would wait on our own window forever.
gmode=$(cat "$WR/$id/gb10" 2>/dev/null || echo legacy)
case $gmode in
  exclusive|shared) ;;
  *) exec 9>"$G"
    # Wait in the queue without stepping out of it (a timed retry loses the place to newer waiters);
    # a separate ticker prints who holds the lock every 60 s.
    ( exec 9>&-; while sleep 60; do echo "spark-calibrate: waiting $(( $(date +%s) - t0 )) s for the GB10 lock: $(spark-window locks gb10)" >&2; done ) &
    tick=$!
    flock 9
    kill $tick 2>/dev/null ;;
esac
gwait=$(( $(date +%s) - t0 ))
held || { echo "spark-calibrate: window $id lapsed (lease ran out or closed) while waiting for the GB10 lock; nothing measured" >&2; exit 1; }
start=$(date -u +%FT%TZ)

stat_csv() {  # median/min/max of column 5 (GB/s) in a probe CSV, as JSON
  grep -v '^#' "$1" | grep -E '^[0-9]' | cut -d, -f5 | sort -n | awk '
    { v[NR] = $1 } END { if (!NR) { print "null"; exit }
      m = (NR % 2) ? v[(NR+1)/2] : (v[NR/2] + v[NR/2+1]) / 2
      printf "{\"reps\": %d, \"GBps_median\": %s, \"GBps_min\": %s, \"GBps_max\": %s}", NR, m, v[1], v[NR] }'
}
avail=$(awk '/MemAvailable/{print $2}' /proc/meminfo)
probe_json=""
for k in 1 8; do
  f=$d/calibration/memcpy_k$k.csv
  if [ "$avail" -lt 15204352 ]; then
    echo "# SKIPPED k=$k: MemAvailable $avail kB under 14.5 GiB" > "$f"; s=null
  else
    nice -n 10 "$P" 1 $k 10 > "$f" 2>&1; s=$(stat_csv "$f")
  fi
  probe_json="$probe_json\"k$k\": $s, "
  avail=$(awk '/MemAvailable/{print $2}' /proc/meminfo)
done

# 30 s idle at the wall; receipt name carries the window id so windows never overwrite each other
spark-receipt "calib-idle-$id" --idle 0 -- sleep 30 > "$d/calibration/idle.out" 2>&1
r=$(sed -n 's/^receipt: //p' "$d/calibration/idle.out")
cp "$r" "$d/calibration/idle-receipt.json"
jv() { sed -n "s/^ *\"$1\": \([^,]*\),\{0,1\}$/\1/p" "$d/calibration/idle-receipt.json"; }
held && wheld=true || wheld=false
flock -u 9

cat > "$d/calibration.json.tmp" <<EOF
{
 "window_id": "$id",
 "start": "$start",
 "gb10_lock_waited_s": $gwait,
 "gb10_lock_held_by": "$( case $gmode in exclusive|shared) echo "window ($gmode)" ;; *) echo calibrate ;; esac )",
 "window_held_throughout": $wheld,
 "memcpy_probe": {"source": "omega research/cost-sim-583@$PIN $SRC", "blob": "$blob", "cflags": "$CFLAGS",
   "binary_sha256": "$(sha256sum "$P" | cut -c1-64)", "cmd": "nice -n 10 memcpy_probe 1 K 10",
   "unit": "GB/s, read+write counted twice, as in M1 block4", ${probe_json%, }},
 "idle": {"seconds": 30, "wall_W_mean": $(jv wall_W_mean), "gpu_W_mean": $(jv gpu_W_mean), "gpu_util_mean": $(jv gpu_util_mean),
   "samples": $(jv samples), "load1_start": $(jv load1_start), "receipt": "$r"},
 "files": "calibration/memcpy_k1.csv calibration/memcpy_k8.csv calibration/idle-receipt.json",
 "note": "wall W is the whole UPS output (UPS ups.load x 10, 10 W steps, ~2 s), not the Spark alone; the GPU is held idle by the GB10 lock during the 30 s but servers stay resident"
}
EOF
mv -f "$d/calibration.json.tmp" "$d/calibration.json"
cat "$d/calibration.json"
echo "calibration: $d/calibration.json"
