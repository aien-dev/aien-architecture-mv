note SPDX-License-Identifier: Apache-2.0
note capreg: check and render the org-wide CUDA capability register
note (docs/capability-register/register.tsv). Seeded native Omega, built only by the compiler
note pinned in tools/zero-legacy/omega.pin. Schema and rules: tools/capreg/README.md.
note usage:
note   capreg check REGISTER.tsv           exit 0 valid, 1 invalid (FAIL lines on stderr)
note   capreg render REGISTER.tsv          markdown view on stdout; exit 1, nothing rendered, if invalid
note   capreg verify REGISTER.tsv VIEW.md  exit 0 only when valid and VIEW.md equals the render
note   capreg evidence REGISTER.tsv ROOT   for each aien-dev/<repo>@<sha>:<path> evidence run
note                                       /usr/bin/git -C ROOT/<repo> cat-file -e <sha>:<path>;
note                                       exit 0 all present, 1 any missing, 3 a clone is missing
note Exit 64 usage, 65 register unreadable or over 500000 bytes. Traps exit 100 + code.
note Capacities: 1024 records, a view of 999000 bytes, paths of 4095 bytes (loop bounds stay under 999999).

note entries of tt, separated by newlines (index: meaning)
note 0 header; 1-4 ref_state forms; 5-10 arch forms; 11-18 levels; 19-20 deploy forms;
note 21-25 verdicts; 26 (post-audit); 27-29 evidence prefixes; 30 -; 31-34 modes;
note 35-77 messages; 78-109 render pieces; 110-156 audit map area names for rows 1..47
text tt "row\tarea\towner_repo\trev\tref_state\tarch\tlevel\tscope\tapi_contract\ttest_command\tevidence\trefusals\tdeploy_state\taudit_claim\taudit_verdict\tnote\nMERGED\nDRAFT_PR#\nOPEN_PR#\nBRANCH:\nhost-aarch64\nhost-x86_64\nGB10\nQEMU\nnone\ngpu:\nNONE_FOUND\nPROPOSED\nIMPLEMENTED\nEXERCISED_HOST\nEXERCISED_EMULATOR\nEXERCISED_GB10\nEXERCISED_OTHER_GPU\nQUALIFIED_GB10\nNOT_DEPLOYED\nDEPLOYED:\nCONFIRMED\nCORRECTED\nOUTDATED\nNEW\nUNVERIFIED\n(post-audit)\naien-dev/\nregister:\nregister:absence/\n-\ncheck\nrender\nverify\nevidence\nusage: capreg check REGISTER.tsv / capreg render REGISTER.tsv / capreg verify REGISTER.tsv VIEW.md / capreg evidence REGISTER.tsv CLONEROOT\nFAIL line \n: \ncapreg: cannot read the register, or it exceeds 500000 bytes\nheader does not match the 16-field schema\nexpected 16 TAB-separated fields\nempty field (write none or - instead)\ncontrol character or backtick in line\nrow must be NN.k with NN 1..47 and k >= 1, no leading zeros\nrows must ascend by (NN, k) with no duplicates\narea is not the audit map name for this row number\nowner_repo must be aien-dev/<name>\nrev must be 40 lowercase hex\nref_state must be MERGED, DRAFT_PR#N, OPEN_PR#N or BRANCH:<name>\narch must be host-aarch64, host-x86_64, GB10, QEMU, gpu:<name> or none\nlevel must be NONE_FOUND, PROPOSED, IMPLEMENTED, EXERCISED_HOST, EXERCISED_EMULATOR, EXERCISED_GB10, EXERCISED_OTHER_GPU or QUALIFIED_GB10\nlevel exceeds or contradicts arch (NONE_FOUND, PROPOSED, IMPLEMENTED: none; EXERCISED_HOST: host-*; EXERCISED_EMULATOR: QEMU; EXERCISED_GB10, QUALIFIED_GB10: GB10; EXERCISED_OTHER_GPU: gpu:*)\nan exercised or qualified level needs a test_command\nevidence must be aien-dev/<repo>@<40-hex sha>:<path> or register:<path> without ..\nNONE_FOUND needs register:absence/ evidence\nregister evidence file does not exist next to the register\ndeploy_state must be NOT_DEPLOYED or DEPLOYED:<system>\nDEPLOYED needs ref_state MERGED\naudit_verdict must be CONFIRMED, CORRECTED, OUTDATED, NEW or UNVERIFIED\nNEW and (post-audit) must go together\nCORRECTED, OUTDATED and UNVERIFIED need a note, not -\nmore than 1024 records\nFAIL: map row \n has no record\ncapreg: register invalid, nothing rendered\nFAIL: view differs from the rendered register; regenerate it with capreg render\nFAIL: view unreadable or over 999000 bytes\nOK records=\nFAIL evidence missing: \nNOT_RUN clone missing: \nOK evidence checked=\n/usr/bin/git\n-C\ncat-file\n-e\n/dev/null\nFAIL: \nfile does not end with a newline\n<!-- Generated by tools/capreg/capreg.om render from register.tsv. Do not edit by hand: edit register.tsv, then regenerate. -->\n# CUDA capability register\nSource of truth: [register.tsv](register.tsv), one record per owner component for each row of the 47-row map in the 2026-10-27 audit, plus work since. Schema, rules and the checker: [tools/capreg/README.md](../../tools/capreg/README.md). A level never exceeds what the cited evidence file shows. A host or emulator pass is not GPU evidence. NONE_FOUND means the recorded search found nothing; it is not proof of absence.\n## Levels\n| Level | Records |\n|---|---|\n## Audit verdicts\n| Verdict | Records |\n## Summary\n| Row | Area | Owner | Level | Arch | State | Audit |\n|---|---|---|---|---|---|---|\n## Records\n### \n#### \n- Level: \n (arch \n- Rev: `\n` (\n- Scope: \n- API: \n- Test: `\n- Evidence: `\n- Refusals: \n- Deploy: \n- Audit claim: \n- Audit verdict: \n. \n| \n | \n |\n)\n`\nCUDA C++\nHost build\nnvcc\nNVVM\nlibdevice\nPTX\nptxas\nDevice linking\nNVRTC\nnvJitLink\ncubin/fatbin\nCUDA Python/cuTile\nRuntime API\nUser-space driver\nMemory interop\nStreams/events\nGraphs\nAdvanced execution\nKernel driver\nFirmware\nCCCL\nCUTLASS-style\ncuBLAS\ncuDNN\ncuTENSOR\ncuSPARSE\ncuSPARSELt\ncuSOLVER\ncuFFT\ncuRAND\nMathDx\nNPP/codecs\nnvCOMP\nDistributed math\nNCCL\nNVSHMEM\nGPUDirect\nBinary utils\nCUDA-GDB\nSanitizer\nCUPTI\nNsight\nNVTX\nNVML/nvidia-smi\nMPS/MIG\nPackaging\nFrameworks\n"

const AREA0 ulong 110
const SRCCAP ulong 500000
const VCAP ulong 999000
const MAXREC ulong 1024

global tso ulong 256
global tsl ulong 256
global src uchar 500001
global srcn ulong 1
global vbuf uchar 999001
global vbn ulong 1
global fo ulong 16384
global fl ulong 16384
global rnn ulong 1024
global rkk ulong 1024
global nrow ulong 1
global pnn ulong 1
global pkk ulong 1
global seen uchar 48
global lvc ulong 8
global vdc ulong 5
global failn ulong 1
global obuf uchar 999001
global obl ulong 1
global ebuf uchar 65536
global ebl ulong 1
global nb uchar 24
global mode uchar 64
global path uchar 4096
global pathl ulong 1
global dirl ulong 1
global p2 uchar 4096
global p2l ulong 1
global tmp uchar 8192
global ab uchar 8192
global abl ulong 1
global pk uchar 4096
global pkn ulong 1
global pkc ulong 1
global status uchar 4

note ---- text table ----

fn tinit to void
s = ulong 0
k = ulong 0
put tso 0 0
n = len tt
while lt s n bound 65536
if eq get tt s 10
put tsl k sub s get tso k
k = add k 1
put tso k add s 1
end
s = add s 1
end
end

note ---- stderr lines ----

fn ec c uchar to void
n = get ebl 0
put ebuf n c
put ebl 0 add n 1
end

fn eflush to void
r = write 2 ebuf 0 get ebl 0
put ebl 0 0
end

fn emit t ulong to void
o = get tso t
n = get tsl t
b = get ebl 0
for i ulong n
put ebuf add b i get tt add o i
end
put ebl 0 add b n
end

note write the decimal digits of v at the end of nb; return how many
fn digs v ulong to ulong
x = v
n = ulong 0
if eq x 0
put nb 23 48
ret 1
end
while gt x 0 bound 20
put nb sub 23 n uchar add 48 rem x 10
x = div x 10
n = add n 1
end
ret n
end

fn enum v ulong to void
n = digs v
for i ulong n
ec get nb add sub 24 n i
end
end

fn efield r ulong f ulong to void
a = fof r f
n = fln r f
for i ulong n
ec get src add a i
end
end

fn fail ln ulong m ulong to void
put failn 0 add get failn 0 1
emit 36
enum ln
emit 37
emit m
ec 10
eflush
end

fn failg m ulong to void
put failn 0 add get failn 0 1
emit 76
emit m
ec 10
eflush
end

note ---- stdout view ----

fn oc c uchar to void
n = get obl 0
put obuf n c
put obl 0 add n 1
end

fn oemit t ulong to void
o = get tso t
n = get tsl t
b = get obl 0
for i ulong n
put obuf add b i get tt add o i
end
put obl 0 add b n
end

fn onum v ulong to void
n = digs v
for i ulong n
oc get nb add sub 24 n i
end
end

fn ofield r ulong f ulong to void
a = fof r f
n = fln r f
b = get obl 0
for i ulong n
put obuf add b i get src add a i
end
put obl 0 add b n
end

fn oflush to bool
n = get obl 0
o = ulong 0
while lt o n bound 999999
k = write 1 obuf o sub n o
if le k 0
ret false
end
o = add o ulong k
end
put obl 0 0
ret true
end

note ---- fields ----

fn fof r ulong f ulong to ulong
ret get fo add mul r 16 f
end

fn fln r ulong f ulong to ulong
ret get fl add mul r 16 f
end

note field f of record r equals entry t
fn feq r ulong f ulong t ulong to bool
n = fln r f
if ne n get tsl t
ret false
end
a = fof r f
b = get tso t
for i ulong n
if ne get src add a i get tt add b i
ret false
end
end
ret true
end

note field f of record r starts with entry t
fn fpre r ulong f ulong t ulong to bool
n = get tsl t
if lt fln r f n
ret false
end
a = fof r f
b = get tso t
for i ulong n
if ne get src add a i get tt add b i
ret false
end
end
ret true
end

fn isdig c uchar to bool
ret and ge c 48 le c 57
end

fn ishex c uchar to bool
if isdig c
ret true
end
ret and ge c 97 le c 102
end

fn namech c uchar to bool
if isdig c
ret true
end
if and ge c 97 le c 122
ret true
end
if and ge c 65 le c 90
ret true
end
ret or or eq c 46 eq c 95 eq c 45
end

note n lowercase hex bytes at offset o inside field f
fn hexrun r ulong f ulong o ulong n ulong to bool
if lt fln r f add o n
ret false
end
a = fof r f
for i ulong n
if not ishex get src add a add o i
ret false
end
end
ret true
end

note the bytes of field f from offset o to its end are one or more digits
fn digtail r ulong f ulong o ulong to bool
n = fln r f
if le n o
ret false
end
a = fof r f
i = o
while lt i n bound 999999
if not isdig get src add a i
ret false
end
i = add i 1
end
ret true
end

note value of m digits at src offset o, or 100000 when a byte is not a digit
fn numat o ulong m ulong to ulong
v = ulong 0
for i ulong m
c = get src add o i
if not isdig c
ret 100000
end
v = add mul v 10 ulong sub c 48
end
ret v
end

note ---- per-field rules ----

note NN.k: NN 1..47 of one or two digits, k 1..9999, no leading zeros; sets rnn and rkk
fn rowid r ulong to bool
n = fln r 0
a = fof r 0
d = ulong 0
while lt d n bound 999999
if eq get src add a d 46
break
end
d = add d 1
end
if or eq d 0 gt d 2
ret false
end
if ge add d 1 n
ret false
end
m = sub sub n d 1
if gt m 4
ret false
end
if or eq get src a 48 eq get src add a add d 1 48
ret false
end
nn = numat a d
kk = numat add a add d 1 m
if or lt nn 1 gt nn 47
ret false
end
if or lt kk 1 gt kk 9999
ret false
end
put rnn r nn
put rkk r kk
ret true
end

fn ownerok r ulong to bool
if not fpre r 2 27
ret false
end
n = fln r 2
if le n 9
ret false
end
a = fof r 2
i = ulong 9
while lt i n bound 999999
if not namech get src add a i
ret false
end
i = add i 1
end
ret true
end

fn refok r ulong to bool
if feq r 4 1
ret true
end
if fpre r 4 2
ret digtail r 4 9
end
if fpre r 4 3
ret digtail r 4 8
end
if fpre r 4 4
ret gt fln r 4 7
end
ret false
end

note arch class: 0 none, 1 host, 2 GB10, 3 QEMU, 4 other GPU, 9 malformed
fn archcls r ulong to ulong
if feq r 5 9
ret 0
end
if or feq r 5 5 feq r 5 6
ret 1
end
if feq r 5 7
ret 2
end
if feq r 5 8
ret 3
end
if fpre r 5 10
if gt fln r 5 4
ret 4
end
end
ret 9
end

note level 0..7 in the order of entries 11..18, 9 malformed
fn levidx r ulong to ulong
for t ulong 8
if feq r 6 add 11 t
ret t
end
end
ret 9
end

note the only arch class each level may claim
fn needarc lv ulong to ulong
if le lv 2
ret 0
end
if eq lv 3
ret 1
end
if eq lv 4
ret 3
end
if eq lv 6
ret 4
end
ret 2
end

fn vidx r ulong to ulong
for t ulong 5
if feq r 14 add 21 t
ret t
end
end
ret 9
end

note aien-dev/<repo>@<40 hex>:<path>
fn evrepo r ulong to bool
if not fpre r 10 27
ret false
end
n = fln r 10
a = fof r 10
q = ulong 9
while lt q n bound 999999
if eq get src add a q 64
break
end
if not namech get src add a q
ret false
end
q = add q 1
end
if or eq q 9 ge q n
ret false
end
if not hexrun r 10 add q 1 40
ret false
end
p = add q 41
if ge p n
ret false
end
if ne get src add a p 58
ret false
end
ret gt n add p 1
end

note register:<path>, nonempty, no .. anywhere
fn evreg r ulong to bool
if not fpre r 10 28
ret false
end
n = fln r 10
if le n 9
ret false
end
a = fof r 10
i = ulong 9
while lt add i 1 n bound 999999
c0 = get src add a i
c1 = get src add a add i 1
if and eq c0 46 eq c1 46
ret false
end
i = add i 1
end
ret true
end

note the register: path exists relative to the register file's directory
fn regfile r ulong to bool
d = get dirl 0
n = fln r 10
m = sub n 9
if gt add d m 4095
ret false
end
for i ulong d
put tmp i get path i
end
a = fof r 10
for j ulong m
put tmp add d j get src add a add 9 j
end
fd = fopen tmp 0 add d m 0 0
if lt fd 0
ret false
end
c = fclose int fd
ret true
end

note ---- record checks ----

fn chkid r ulong ln ulong to void
if not rowid r
fail ln 43
ret
end
nn = get rnn r
kk = get rkk r
up = gt nn get pnn 0
if and eq nn get pnn 0 gt kk get pkk 0
up = true
end
if up
put pnn 0 nn
put pkk 0 kk
else
fail ln 44
end
put seen nn 1
if not feq r 1 add AREA0 sub nn 1
fail ln 45
end
end

fn chkrow r ulong ln ulong to void
chkid r ln
if not ownerok r
fail ln 46
end
if or ne fln r 3 40 not hexrun r 3 0 40
fail ln 47
end
if not refok r
fail ln 48
end
ac = archcls r
if eq ac 9
fail ln 49
end
lv = levidx r
if eq lv 9
fail ln 50
else
put lvc lv add get lvc lv 1
if and ne ac 9 ne ac needarc lv
fail ln 51
end
if and ge lv 3 feq r 9 9
fail ln 52
end
end
chkev r ln lv
chkend r ln
end

fn chkev r ulong ln ulong lv ulong to void
er = evrepo r
eg = evreg r
if not or er eg
fail ln 53
end
if and eq lv 0 not fpre r 10 29
fail ln 54
end
if eg
if not regfile r
fail ln 55
end
end
end

fn chkend r ulong ln ulong to void
nd = feq r 12 19
dp = fpre r 12 20
if dp
if le fln r 12 9
dp = false
end
end
if not or nd dp
fail ln 56
end
if and dp not feq r 4 1
fail ln 57
end
vd = vidx r
if eq vd 9
fail ln 58
else
put vdc vd add get vdc vd 1
end
isnew = eq vd 3
post = feq r 13 26
if ne isnew post
fail ln 59
end
bad = or or eq vd 1 eq vd 2 eq vd 4
if and bad feq r 15 30
fail ln 60
end
end

note ---- parsing ----

fn header s ulong e ulong to bool
n = sub e s
if ne n get tsl 0
ret false
end
b = get tso 0
for i ulong n
if ne get src add s i get tt add b i
ret false
end
end
ret true
end

note bytes s..e (e excluded) are one line: no control byte but TAB, no backtick; count the TABs
fn tabs s ulong e ulong to ulong
k = ulong 0
i = s
while lt i e bound 999999
c = get src i
if eq c 9
k = add k 1
else
if or lt c 32 eq c 96
ret 99999
end
end
i = add i 1
end
ret k
end

fn store r ulong s ulong e ulong to void
f = ulong 0
b = s
i = s
base = mul r 16
while lt i e bound 999999
if eq get src i 9
put fo add base f b
put fl add base f sub i b
f = add f 1
b = add i 1
end
i = add i 1
end
put fo add base f b
put fl add base f sub e b
end

fn doline s ulong e ulong ln ulong to void
if eq ln 1
if not header s e
fail ln 39
end
ret
end
k = tabs s e
if eq k 99999
fail ln 42
ret
end
if ne k 15
fail ln 40
ret
end
r = get nrow 0
if ge r MAXREC
fail ln 61
ret
end
store r s e
put nrow 0 add r 1
for f ulong 16
if eq fln r f 0
fail ln 41
ret
end
end
chkrow r ln
end

fn parse to void
n = get srcn 0
if eq n 0
fail 1 39
ret
end
if ne get src sub n 1 10
failg 77
end
s = ulong 0
ln = ulong 1
while lt s n bound 999999
e = s
while lt e n bound 999999
if eq get src e 10
break
end
e = add e 1
end
doline s e ln
s = add e 1
ln = add ln 1
end
for i ulong 47
if eq get seen add i 1 0
put failn 0 add get failn 0 1
emit 62
enum add i 1
emit 63
ec 10
eflush
end
end
end

note ---- files ----

fn loadreg to bool
fd = fopen path 0 get pathl 0 0 0
if lt fd 0
ret false
end
n = ulong 0
k = long 0
while lt n 500001 bound 500002
k = read int fd src n sub 500001 n
if le k 0
break
end
n = add n ulong k
end
c = fclose int fd
if lt k 0
ret false
end
if gt n SRCCAP
ret false
end
put srcn 0 n
ret true
end

fn loadview to bool
fd = fopen p2 0 get p2l 0 0 0
if lt fd 0
ret false
end
n = ulong 0
k = long 0
while lt n 999001 bound 999002
k = read int fd vbuf n sub 999001 n
if le k 0
break
end
n = add n ulong k
end
c = fclose int fd
if lt k 0
ret false
end
if gt n VCAP
ret false
end
put vbn 0 n
ret true
end

note ---- render ----

fn nl to void
oc 10
end

fn cnttab hd ulong t0 ulong m ulong which ulong to void
oemit hd
nl
nl
if eq which 0
oemit 82
else
oemit 85
end
nl
oemit 83
nl
for i ulong m
oemit 105
oemit add t0 i
oemit 106
if eq which 0
onum get lvc i
else
onum get vdc i
end
oemit 107
nl
end
nl
end

fn sumrow r ulong to void
oemit 105
ofield r 0
oemit 106
ofield r 1
oemit 106
ofield r 2
oemit 106
ofield r 6
oemit 106
ofield r 5
oemit 106
ofield r 4
oemit 106
ofield r 14
oemit 107
nl
end

fn line t ulong r ulong f ulong to void
oemit t
ofield r f
nl
end

fn record r ulong to void
nl
oemit 91
ofield r 0
oc 32
ofield r 2
nl
nl
oemit 92
ofield r 6
oemit 93
ofield r 5
oemit 108
nl
oemit 94
ofield r 3
oemit 95
ofield r 4
oemit 108
nl
line 96 r 7
line 97 r 8
oemit 98
ofield r 9
oemit 109
nl
oemit 99
ofield r 10
oemit 109
nl
line 100 r 11
line 101 r 12
line 102 r 13
oemit 103
ofield r 14
if not feq r 15 30
oemit 104
ofield r 15
end
nl
end

fn render to void
oemit 78
nl
nl
oemit 79
nl
nl
oemit 80
nl
nl
cnttab 81 11 8 0
cnttab 84 21 5 1
oemit 86
nl
nl
oemit 87
nl
oemit 88
nl
for r ulong get nrow 0
sumrow r
end
nl
oemit 89
nl
pn = ulong 0
for r ulong get nrow 0
nn = get rnn r
if ne nn pn
nl
oemit 90
onum nn
oc 46
oc 32
oemit add AREA0 sub nn 1
nl
pn = nn
end
record r
end
end

fn same to bool
n = get obl 0
if ne n get vbn 0
ret false
end
for i ulong n
if ne get obuf i get vbuf i
ret false
end
end
ret true
end

note ---- evidence mode ----

fn pk0 to void
put pkn 0 2
put pkc 0 0
end

note append ab as one record of the execprog packet
fn pka to void
n = get pkn 0
m = get abl 0
put pk n uchar rem m 256
put pk add n 1 uchar div m 256
for i ulong m
put pk add n add 2 i get ab i
end
put pkn 0 add n add 2 m
c = add get pkc 0 1
put pkc 0 c
put pk 0 uchar rem c 256
put pk 1 uchar div c 256
end

fn abt t ulong to void
o = get tso t
n = get tsl t
for i ulong n
put ab i get tt add o i
end
put abl 0 n
end

note ab gets field 10 of r from offset o for n bytes, appended after k existing bytes
fn abf r ulong o ulong n ulong k ulong to void
a = fof r 10
for i ulong n
put ab add k i get src add a add o i
end
put abl 0 add k n
end

fn child to void
fd = fopen tt get tso 75 get tsl 75 1 0
if ge fd 0
r = dupfd int fd 1 0
r = dupfd int fd 2 0
end
r = execprog pk 0 get pkn 0
exit 127
end

fn run to long
pid = fork
if lt pid 0
ret -1
end
if eq pid 0
child
end
r = waitpid int pid status 0 4 0
if ne r pid
ret -1
end
if ne get status 0 0
ret -1
end
ret long get status 1
end

note 0 present, 1 missing, 3 clone directory missing or git not runnable
fn evone r ulong to ulong
n = fln r 10
a = fof r 10
q = ulong 9
while ne get src add a q 64 bound 999999
q = add q 1
end
pk0
abt 71
pka
abt 72
pka
k = get p2l 0
for i ulong k
put ab i get p2 i
end
put ab k 47
abf r 9 sub q 9 add k 1
fd = fopen ab 0 get abl 0 0 0
if lt fd 0
emit 69
for j ulong get abl 0
ec get ab j
end
ec 10
eflush
ret 3
end
c = fclose int fd
pka
abt 73
pka
abt 74
pka
abf r add q 1 sub sub n q 1 0
pka
x = run
if eq x 0
ret 0
end
if or lt x 0 eq x 127
ret 3
end
emit 68
efield r 10
ec 10
eflush
ret 1
end

fn evcheck to int
miss = ulong 0
nocl = ulong 0
done = ulong 0
for r ulong get nrow 0
if evrepo r
x = evone r
if eq x 0
done = add done 1
end
if eq x 1
miss = add miss 1
end
if eq x 3
nocl = add nocl 1
end
end
end
if gt miss 0
ret 1
end
if gt nocl 0
ret 3
end
emit 70
enum done
ec 10
r = write 1 ebuf 0 get ebl 0
put ebl 0 0
ret 0
end

note ---- main ----

fn usage to int
emit 35
ec 10
eflush
ret 64
end

fn modeis t ulong m ulong to bool
if ne m get tsl t
ret false
end
o = get tso t
for i ulong m
if ne get mode i get tt add o i
ret false
end
end
ret true
end

fn main to int
tinit
ac = argcnt
if or lt ac 3 gt ac 4
ret usage
end
m = argread 1 mode 0 64
if lt m 1
ret usage
end
md = ulong 9
for t ulong 4
if modeis add 31 t ulong m
md = t
end
end
if eq md 9
ret usage
end
if ne ge md 2 eq ac 4
ret usage
end
n = argread 2 path 0 4095
if lt n 1
ret usage
end
put pathl 0 ulong n
d = ulong 0
for i ulong ulong n
if eq get path i 47
d = add i 1
end
end
put dirl 0 d
if eq ac 4
k = argread 3 p2 0 4095
if lt k 1
ret usage
end
put p2l 0 ulong k
end
if not loadreg
emit 38
ec 10
eflush
ret 65
end
parse
if gt get failn 0 0
if eq md 1
emit 64
ec 10
eflush
end
ret 1
end
if eq md 0
emit 67
enum get nrow 0
ec 10
r = write 1 ebuf 0 get ebl 0
put ebl 0 0
ret 0
end
if eq md 3
ret evcheck
end
render
if eq md 1
if not oflush
ret 1
end
ret 0
end
if not loadview
emit 66
ec 10
eflush
ret 1
end
if not same
emit 65
ec 10
eflush
ret 1
end
ret 0
end
