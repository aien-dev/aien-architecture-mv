note EC303 v1 structural admission. This does not authenticate or approve evidence.
note Forty fixed capability families; 20 fields per row. See FORMAT.md.
global EC ulong 800
global Seen ulong 40
global Reach ulong 1600

fn ecrequire id ulong to ulong
if or eq id 15 or eq id 16 or eq id 19 eq id 20
ret 7
end
if or eq id 8 or eq id 13 eq id 14
ret 3
end
if or eq id 18 and ge id 21 le id 23
ret 3
end
if or eq id 27 and ge id 30 le id 35
ret 3
end
if or eq id 12 eq id 24
ret 2
end
if or and ge id 4 le id 7 eq id 9
ret 1
end
if or eq id 17 and ge id 36 le id 38
ret 1
end
ret 0
end

fn ecfield row ulong col ulong to ulong
ret get EC add mul row 20 col
end

fn ecvalidate version ulong count ulong to ulong
if ne version 1
ret 1
end
if ne count 40
ret 2
end
for i ulong 40
put Seen i 0
end
for i ulong 1600
put Reach i 0
end
for i ulong 40
id = ecfield i 0
if or lt id 1 gt id 40
ret 3
end
if ne get Seen sub id 1 0
ret 3
end
put Seen sub id 1 add i 1
if or lt ecfield i 1 1 gt ecfield i 1 4
ret 4
end
if or eq ecfield i 2 0 eq ecfield i 3 0
ret 4
end
state = ecfield i 4
tier = ecfield i 5
needs = ecfield i 6
if or gt state 4 or gt tier 3 gt needs 7
ret 5
end
if ne and needs ecrequire id ecrequire id
ret 19
end
deps = ecfield i 7
if gt deps 1099511627775
ret 6
end
if ne and deps shl 1 sub id 1 0
ret 6
end
for j ulong 40
if ne and deps shl 1 j 0
put Reach add mul sub id 1 40 j 1
end
end
if gt state 0
if or eq ecfield i 8 0 eq ecfield i 9 0
ret 7
end
end
if ge state 2
if or eq tier 0 or eq ecfield i 10 0 eq ecfield i 11 0
ret 8
end
if or eq ecfield i 18 0 eq ecfield i 18 ecfield i 3
ret 9
end
if eq ecfield i 16 0
ret 10
end
if ne and needs 1 0
if eq ecfield i 17 0
ret 11
end
end
if ne and needs 2 0
if eq ecfield i 15 0
ret 12
end
end
if ne and needs 4 0
if ne tier 3
ret 13
end
end
end
if ge state 3
if or eq ecfield i 12 0 eq ecfield i 14 0
ret 14
end
end
if eq state 4
if eq ecfield i 13 0
ret 15
end
end
if ne ecfield i 19 0
ret 16
end
end
note Transitive closure detects cycles even in entirely pending rows.
for k ulong 40
for i ulong 40
if ne get Reach add mul i 40 k 0
for j ulong 40
if ne get Reach add mul k 40 j 0
put Reach add mul i 40 j 1
end
end
end
end
end
for i ulong 40
if ne get Reach add mul i 40 i 0
ret 17
end
row = sub get Seen i 1
if ge ecfield row 4 3
for j ulong 40
if ne get Reach add mul i 40 j 0
dep = sub get Seen j 1
if lt ecfield dep 4 3
ret 18
end
end
end
end
end
ret 0
end
note Independent reviewer fixture. All refs are synthetic, never evidence.
global RC ulong 1
global Num uchar 20
text RP "EC303_REVIEW_PASS checks="
text RF "EC303_REVIEW_FAIL check="
text RNL "\n"

fn rout n ulong to void
p = ulong 20
while gt n 0 bound 20
p = sub p 1
put Num p uchar add rem n 10 48
n = div n 10
end
w = write 1 Num p sub 20 p
if ne w long sub 20 p
exit 90
end
end

fn rcheck want ulong got ulong to void
put RC 0 add get RC 0 1
if ne want got
w = write 1 RF 0 len RF
rout get RC 0
w = write 1 RNL 0 1
exit 1
end
end

fn rfull to void
for i ulong 800
put EC i 0
end
for i ulong 40
b = mul i 20
put EC b add i 1
put EC add b 1 1
put EC add b 2 663
put EC add b 3 787
put EC add b 4 4
put EC add b 5 3
put EC add b 6 7
for j ulong 10
put EC add b add j 8 1
end
put EC add b 18 786
end
end

fn missing col ulong to ulong
if or eq col 8 eq col 9
ret 7
end
if or eq col 10 eq col 11
ret 8
end
if or eq col 12 eq col 14
ret 14
end
if eq col 13
ret 15
end
if eq col 15
ret 12
end
if eq col 16
ret 10
end
ret 11
end

fn allrefs to void
rfull
rcheck 0 ecvalidate 1 40
for i ulong 40
for j ulong 10
col = add j 8
offset = add mul i 20 col
put EC offset 0
rcheck missing col ecvalidate 1 40
put EC offset 1
end
b = mul i 20
put EC add b 18 787
rcheck 9 ecvalidate 1 40
put EC add b 18 786
put EC add b 5 2
rcheck 13 ecvalidate 1 40
put EC add b 5 3
put EC add b 3 0
rcheck 4 ecvalidate 1 40
put EC add b 3 787
put EC add b 19 18446744073709551615
rcheck 16 ecvalidate 1 40
put EC add b 19 0
end
end

fn graph to void
rfull
for i ulong 39
put EC add mul i 20 7 shl ulong 1 add i 1
end
rcheck 0 ecvalidate 1 40
for i ulong 39
b = mul add i 1 20
for s ulong 3
put EC add b 4 s
rcheck 18 ecvalidate 1 40
end
put EC add b 4 4
end
put EC 787 1
rcheck 17 ecvalidate 1 40
for i ulong 40
put EC add mul i 20 4 0
end
rcheck 17 ecvalidate 1 40
put EC 787 0
for i ulong 40
put EC add mul i 20 4 4
end
note Full reversal tests ID-based dependencies, not row-based traversal.
for i ulong 20
a = mul i 20
b = mul sub 39 i 20
for j ulong 20
t = get EC add a j
put EC add a j get EC add b j
put EC add b j t
end
end
rcheck 0 ecvalidate 1 40
put EC 4 2
rcheck 18 ecvalidate 1 40
rfull
put EC 7 1099511627776
rcheck 6 ecvalidate 1 40
put EC 7 18446744073709551615
rcheck 6 ecvalidate 1 40
end

fn policies to void
rfull
rcheck 1 ecvalidate 18446744073709551615 40
rcheck 2 ecvalidate 1 0
rcheck 2 ecvalidate 1 18446744073709551615
for i ulong 40
b = mul i 20
put EC add b 6 0
need = ecrequire add i 1
if ne need 0
rcheck 19 ecvalidate 1 40
else
rcheck 0 ecvalidate 1 40
end
put EC add b 6 7
end
end

fn main to int
allrefs
graph
policies
w = write 1 RP 0 len RP
rout get RC 0
w = write 1 RNL 0 1
ret 0
end
